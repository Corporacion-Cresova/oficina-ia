# =====================================================================
#  OFICINA DE IA — variables de entorno
#  Copiá este archivo a `.env` y completá SOLO lo que vayas a usar.
#  NUNCA subas el .env a git. Casi todas las llaves también se pueden
#  cargar luego desde la oficina: Sistema → Llaves.
# =====================================================================

# ---- Cerebro (obligatorio: UNA de las dos; sin ninguna arranca en modo demo)
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=        # token de `claude setup-token` (tu suscripción)

# ---- Acceso a la oficina
OFFICE_PASSWORD=                  # contraseña para entrar (obligatoria si es pública)
OFFICE_TZ=America/Tegucigalpa     # zona horaria de los horarios de los agentes
AGENT_MAX_BUDGET_USD=3            # tope de gasto por corrida de agente
# AGENT_MODEL=
# AGENT_EFFORT=

# ---- Datos de TU empresa (salen en cotizaciones, textos publicados y commits)
EMPRESA_RAZON_SOCIAL=
EMPRESA_RTN=
EMPRESA_CORREO=
EMPRESA_WHATSAPP=                 # número de ventas, con formato (+504 ...)
OWNER_WHATSAPP=                   # WhatsApp del dueño (solo dígitos) para avisos y resumen semanal
# NUMERO_PERSONAL=                # opcional: número personal que NO debe salir en lo publicado
GIT_NOMBRE=
GIT_CORREO=

# ---- Base de datos propia (Postgres). Crear con cresova/schema.sql
DATABASE_URL=

# ---- Ventas por WhatsApp
OPENROUTER_API_KEY=               # cerebro del vendedor de WhatsApp
YCLOUD_API_KEY=                   # WhatsApp oficial (API de Meta vía YCloud)
EVOLUTION_API_URL=                # alternativa: Evolution API
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ---- Video, voz y publicación
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
GEMINI_API_KEY=
RUNWARE_API_KEY=
UPLOADPOST_API_KEY=
UPLOADPOST_PROFILE=
UPLOADPOST_FB_PAGE=
YOUTUBE_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_VOICE_CHANNEL=

# ---- Meta (anuncios y conversiones)
METAADS_TOKEN=
META_AD_ACCOUNT=                  # act_XXXXXXXX
META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAMPANA_PRINCIPAL=

# ---- Otros opcionales
RESEND_API_KEY=                   # correos de prospección
GOOGLE_CLIENT_ID=                 # Google Calendar / Meet
GOOGLE_CLIENT_SECRET=
GASTOS_API_KEY=                   # webhook de gastos (n8n)
SITIOS_API_KEY=
SITIOS_URL=
CRESOVA_MCP_API_KEY=              # solo si tenés un sistema externo compatible; si no, dejalo vacío
